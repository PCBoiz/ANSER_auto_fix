JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- n8n ---
# Chiều app -> n8n (webhook). Xem docker-compose.yml.
N8N_WEBHOOK_URL=http://localhost:5681/webhook
# Email nhận báo cáo/cảnh báo khi chưa cấu hình email ở trang Cài đặt doanh nghiệp.
N8N_NOTIFY_EMAIL=admin@example.com

# Bảo vệ các endpoint /api/n8n/internal/* (trả về tên/SĐT/email khách hàng).
# Chuỗi này phải khớp header X-Internal-Token trong các node HTTP Request của workflow.
# Để trống thì chạy được ở development, nhưng ở production endpoint sẽ trả 503.
N8N_INTERNAL_TOKEN=

# Tạo ở n8n UI: Settings -> n8n API -> Create an API key. Cần để nút Chạy/Dừng/Lịch sử ở trang
# Tự động hoá gọi n8n API thật (thay vì chỉ đổi trạng thái trong DB của app).
N8N_API_URL=http://localhost:5681
N8N_API_KEY=

# --- Bảo mật & khởi tạo (bổ sung 17/09/2026) ---
# Tạo quản trị viên đầu tiên lúc khởi động — CHỈ khi DB chưa có admin nào. Mật khẩu này bị bắt
# đổi ở lần đăng nhập đầu. Không đặt thì không tạo gì: DB rỗng sẽ cho đăng ký đúng 1 tài khoản
# đầu tiên (thành admin) rồi tự đóng cửa đăng ký.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Mở đăng ký công khai (ai cũng tự tạo được tài khoản staff). CHỈ dùng cho bản demo.
# ALLOW_PUBLIC_REGISTER=true

# Bảo vệ /api/cron/automation (bộ lập lịch nội bộ, chạy được không cần n8n). Vercel Cron tự gửi
# "Authorization: Bearer <CRON_SECRET>". Thiếu ở production thì endpoint trả 503.
CRON_SECRET=

# Chỉ dành cho máy dev: nút điền nhanh tài khoản ở trang đăng nhập. KHÔNG BAO GIỜ đọc ở
# production (biến NEXT_PUBLIC_* đi vào JavaScript gửi tới trình duyệt).
# NEXT_PUBLIC_DEV_QUICK_ACCOUNTS=[{"label":"Kế toán","email":"...","password":"..."}]

# Seed dữ liệu MINH HOẠ (7 phụ tùng Toyota, 8 hạng mục, 5 nhân sự tên giả) khi bảng rỗng.
# Chỉ bật trên máy dev/bản demo. Không đặt thì hệ thống chỉ tạo chi nhánh mặc định + quy tắc
# tự động — và dữ liệu mẫu đã dọn sẽ không quay lại sau khi khởi động lại.
# SEED_DEMO_DATA=true

# --- Vòng lặp vận hành (bổ sung 18/09/2026) ---
# Lịch nội bộ trong tiến trình — cho bản TỰ HOST: canh gác mỗi 30 phút, bản tin sáng 7h, tổng
# hợp kế toán 8h thứ Hai. KHÔNG bật trên Vercel (serverless không sống liên tục) — ở đó dùng
# vercel.json. Dịch vụ `app` trong docker-compose.yml đã bật sẵn.
# INTERNAL_SCHEDULER=true
# Địa chỉ app mà CONTAINER n8n gọi tới — được điền vào workflow lúc đồng bộ. Mặc định
# http://host.docker.internal:3000 (app chạy ngoài Docker); chạy chung compose thì là http://app:3000.
# APP_URL_FOR_N8N=http://host.docker.internal:3000
# Sao lưu tự động mỗi ngày 2h sáng (cần INTERNAL_SCHEDULER=true), đọc lại để kiểm chứng, giữ
# BACKUP_KEEP bản mới nhất (mặc định 14). KHÔNG đặt trên Vercel — hệ thống file ở đó là tạm.
# BACKUP_DIR=backups
# BACKUP_KEEP=14
# Bản sao THỨ HAI, ngoài máy chủ: thư mục Google Drive for Desktop / OneDrive / Dropbox (phần mềm
# đồng bộ lo việc đưa lên mây). Mỗi bản sao lưu được chép sang đây và đọc lại so sha256.
# BACKUP_COPY_DIR=G:/My Drive/ANSER-sao-luu

# --- Báo động (bổ sung 20/09/2026) ---
# Canh gác từ BÊN NGOÀI: mỗi lượt canh gác gửi nhịp tới đây (healthchecks.io: tạo check chu kỳ
# 30 phút, ân hạn 30 phút, bật email). Máy chủ mất điện/mất mạng -> nhịp ngừng -> dịch vụ đó
# tự email. Hệ thống hỏng -> gửi ".../fail" -> cũng email.
# HEARTBEAT_URL=https://hc-ping.com/<uuid>
# Địa chỉ mà NGƯỜI dùng mở app (để email báo nhanh có link "Mở trang xử lý").
# APP_PUBLIC_URL=http://192.168.1.10:3000
