{
  "name": "ANSER Auto — Nhắc chờ nghiệm thu quá hạn",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "ar-trigger",
      "name": "Mỗi ngày 9h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        180,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:3000/api/n8n/internal/awaiting-acceptance",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "REPLACE_WITH_N8N_INTERNAL_TOKEN"
            },
            {
              "name": "X-Anser-Trigger",
              "value": "={{ $execution.mode === 'production' ? 'schedule' : 'manual' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "ar-fetch",
      "name": "Lấy lệnh chờ nghiệm thu",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "items",
        "options": {}
      },
      "id": "ar-split",
      "name": "Tách từng lệnh",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        620,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.contactable }}",
              "value2": true
            }
          ]
        }
      },
      "id": "ar-if-contactable",
      "name": "Khách có email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        840,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Một email cho MỖI khách — nhắc nghiệm thu là thư cá nhân, không phải bảng tổng hợp.\nconst v = $json;\nconst company = $('Lấy lệnh chờ nghiệm thu').first().json.company_name || 'Gara';\n\nconst html = `<h2>🚗 Xe ${v.license_plate} đã sẵn sàng, đang chờ Quý khách nghiệm thu</h2>`\n  + `<p>Chào ${v.customer_name || 'Quý khách'},</p>`\n  + `<p>Xe <b>${v.vehicle}</b> — biển số <b>${v.license_plate}</b> (lệnh <b>${v.order_code}</b>) đã sửa xong và đang chờ Quý khách tới kiểm tra, nghiệm thu — đã <b>${v.days_waiting} ngày</b> mà chưa thấy Quý khách ghé.</p>`\n  + `<p>Quý khách vui lòng sắp xếp tới xưởng nhận xe, hoặc liên hệ lại nếu cần dời lịch.</p>`\n  + `<p style=\"color:#888;font-size:12px\">${company}</p>`;\n\nreturn { json: {\n  email_to: v.customer_email,\n  email_subject: `🚗 Xe ${v.license_plate} đang chờ Quý khách nghiệm thu`,\n  email_html: html\n} };"
      },
      "id": "ar-format",
      "name": "Soạn thư cho khách",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        120
      ]
    },
    {
      "parameters": {
        "fromEmail": "care@anser.auto",
        "toEmail": "={{ $json.email_to }}",
        "subject": "={{ $json.email_subject }}",
        "html": "={{ $json.email_html }}",
        "options": {}
      },
      "id": "ar-email-customer",
      "name": "Gửi khách hàng",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1280,
        120
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.count }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "ar-if-count",
      "name": "Có lệnh chờ quá hạn?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        620,
        440
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Bản tổng hợp cho gara — cột \"Liên hệ\" chỉ rõ khách nào không có email, phải gọi điện\n// thay vì trông chờ email tự động, giống các workflow nhắc khác.\nconst d = $json;\nconst items = d.items || [];\nconst khongCoEmail = items.filter(v => !v.contactable);\n\nconst rows = items.map(v => `<tr><td>${v.order_code}</td><td>${v.license_plate}</td><td>${v.customer_name || '—'}</td><td>${v.customer_phone || '—'}</td><td align=\"right\">${v.days_waiting}</td><td>${v.contactable ? 'Đã gửi email' : '⚠️ Gọi điện'}</td></tr>`).join('');\n\nconst html = `<h2>🔧 ${items.length} lệnh đang chờ nghiệm thu quá hạn</h2>`\n  + `<p>Đã gửi email tự động cho <b>${d.contactable_count}</b> khách. Còn <b>${khongCoEmail.length}</b> khách chưa có email — cần gọi điện.</p>`\n  + `<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse:collapse\">`\n  + `<tr><th>Lệnh</th><th>Biển số</th><th>Khách hàng</th><th>SĐT</th><th>Số ngày chờ</th><th>Liên hệ</th></tr>${rows}</table>`\n  + `<p style=\"color:#888;font-size:12px\">ANSER Auto — ${new Date().toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' })}</p>`;\n\nreturn { json: { email_to: d.company_email, email_subject: `🔧 ${items.length} lệnh chờ nghiệm thu quá hạn`, email_html: html } };"
      },
      "id": "ar-format-summary",
      "name": "Soạn bản tổng hợp",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        440
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.email_to }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "ar-if-company-email",
      "name": "Gara có email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1060,
        440
      ]
    },
    {
      "parameters": {
        "fromEmail": "alerts@anser.auto",
        "toEmail": "={{ $json.email_to }}",
        "subject": "={{ $json.email_subject }}",
        "html": "={{ $json.email_html }}",
        "options": {}
      },
      "id": "ar-email-garage",
      "name": "Gửi gara",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1280,
        440
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3000/api/n8n/internal/heartbeat",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "REPLACE_WITH_N8N_INTERNAL_TOKEN"
            },
            {
              "name": "X-Anser-Trigger",
              "value": "={{ $execution.mode === 'production' ? 'schedule' : 'manual' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"type\": \"awaiting_acceptance_reminder\", \"status\": \"ok\"}",
        "options": {}
      },
      "id": "hb-awaiting_acceptance_reminder",
      "name": "Báo app: đã gửi",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1520,
        440
      ],
      "executeOnce": true
    }
  ],
  "connections": {
    "Mỗi ngày 9h": {
      "main": [
        [
          {
            "node": "Lấy lệnh chờ nghiệm thu",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lấy lệnh chờ nghiệm thu": {
      "main": [
        [
          {
            "node": "Tách từng lệnh",
            "type": "main",
            "index": 0
          },
          {
            "node": "Có lệnh chờ quá hạn?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tách từng lệnh": {
      "main": [
        [
          {
            "node": "Khách có email?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Khách có email?": {
      "main": [
        [
          {
            "node": "Soạn thư cho khách",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Soạn thư cho khách": {
      "main": [
        [
          {
            "node": "Gửi khách hàng",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Có lệnh chờ quá hạn?": {
      "main": [
        [
          {
            "node": "Soạn bản tổng hợp",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Soạn bản tổng hợp": {
      "main": [
        [
          {
            "node": "Gara có email?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gara có email?": {
      "main": [
        [
          {
            "node": "Gửi gara",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Gửi gara": {
      "main": [
        [
          {
            "node": "Báo app: đã gửi",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
