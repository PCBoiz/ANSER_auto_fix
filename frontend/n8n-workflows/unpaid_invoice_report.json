{
  "name": "ANSER Auto — Báo cáo công nợ",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "ui-trigger",
      "name": "Mỗi ngày 9h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        180,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:3000/api/n8n/internal/unpaid-invoices",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "REPLACE_WITH_N8N_INTERNAL_TOKEN"
            },
            {
              "name": "X-Anser-Trigger",
              "value": "={{ $execution.mode === 'production' ? 'schedule' : 'manual' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "ui-fetch",
      "name": "Lấy hoá đơn chưa thu",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Báo cáo NỘI BỘ cho quản lý — không có nhánh gửi khách. Nhắc nợ qua email tự động dễ sai\n// giọng văn với từng khách; quản lý xem danh sách này rồi tự quyết cách đòi (gọi điện,\n// nhắn riêng...), giống cách bản tổng hợp của các workflow khác chỉ rõ ai cần liên hệ tay.\nconst d = $json;\nconst items = d.items || [];\nconst vnd = n => new Intl.NumberFormat('vi-VN').format(n || 0) + '₫';\nconst STATUS_LABEL = { unpaid: 'Chưa thu', partial: 'Thu một phần' };\n\nconst rows = items.map(v => `<tr><td>${v.invoice_code}</td><td>${v.license_plate}</td><td>${v.customer_name || '—'}</td><td>${v.customer_phone || '—'}</td><td align=\"right\">${vnd(v.outstanding)}</td><td align=\"right\">${v.days_old}</td><td>${STATUS_LABEL[v.status] || v.status}</td></tr>`).join('');\n\nconst html = `<h2>💰 ${items.length} hoá đơn chưa thu đủ quá hạn</h2>`\n  + `<p>Tổng công nợ còn phải thu: <b style=\"color:#c00\">${vnd(d.total_outstanding)}</b>.</p>`\n  + `<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse:collapse\">`\n  + `<tr><th>Hoá đơn</th><th>Biển số</th><th>Khách hàng</th><th>SĐT</th><th>Còn nợ</th><th>Số ngày</th><th>Trạng thái</th></tr>${rows}</table>`\n  + `<p style=\"color:#888;font-size:12px\">${d.company_name} — ${new Date().toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' })}</p>`;\n\nreturn { json: {\n  email_to: d.company_email || '',\n  email_subject: `💰 ${items.length} hoá đơn chưa thu — tổng ${vnd(d.total_outstanding)}`,\n  email_html: html\n} };"
      },
      "id": "ui-format",
      "name": "Soạn báo cáo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        620,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.email_to }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "ui-if-email",
      "name": "Có email nhận?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        840,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "reports@anser.auto",
        "toEmail": "={{ $json.email_to }}",
        "subject": "={{ $json.email_subject }}",
        "html": "={{ $json.email_html }}",
        "options": {}
      },
      "id": "ui-email",
      "name": "Gửi Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1060,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3000/api/n8n/internal/heartbeat",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "REPLACE_WITH_N8N_INTERNAL_TOKEN"
            },
            {
              "name": "X-Anser-Trigger",
              "value": "={{ $execution.mode === 'production' ? 'schedule' : 'manual' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"type\": \"unpaid_invoice_report\", \"status\": \"ok\"}",
        "options": {}
      },
      "id": "hb-unpaid_invoice_report",
      "name": "Báo app: đã gửi",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1300,
        220
      ],
      "executeOnce": true
    }
  ],
  "connections": {
    "Mỗi ngày 9h": {
      "main": [
        [
          {
            "node": "Lấy hoá đơn chưa thu",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lấy hoá đơn chưa thu": {
      "main": [
        [
          {
            "node": "Soạn báo cáo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Soạn báo cáo": {
      "main": [
        [
          {
            "node": "Có email nhận?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Có email nhận?": {
      "main": [
        [
          {
            "node": "Gửi Email",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Gửi Email": {
      "main": [
        [
          {
            "node": "Báo app: đã gửi",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
