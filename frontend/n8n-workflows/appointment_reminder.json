{
  "name": "ANSER Auto — Nhắc lịch hẹn",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 17
            }
          ]
        }
      },
      "id": "ar-trigger",
      "name": "Mỗi ngày 17h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        180,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:3000/api/n8n/internal/appointments",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "REPLACE_WITH_N8N_INTERNAL_TOKEN"
            },
            {
              "name": "X-Anser-Trigger",
              "value": "={{ $execution.mode === 'production' ? 'schedule' : 'manual' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "ar-fetch",
      "name": "Lấy lịch hẹn 24h tới",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "items",
        "options": {}
      },
      "id": "ar-split",
      "name": "Tách từng lịch hẹn",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        620,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.contactable }}",
              "value2": true
            }
          ]
        }
      },
      "id": "ar-if-contactable",
      "name": "Khách có email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        840,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Giờ hẹn đã được server format sẵn theo Asia/Ho_Chi_Minh (`scheduled_at_text`).\n// KHÔNG tự format lại ở đây: container n8n có thể chạy timezone khác, và email báo\n// sai giờ hẹn còn tệ hơn không gửi email nào.\nconst a = $json;\n\nconst html = `<h2>📅 Nhắc lịch hẹn tại ${a.branch_name}</h2>`\n  + `<p>Chào ${a.customer_name || 'Quý khách'},</p>`\n  + `<p>Quý khách có lịch hẹn vào <b>${a.scheduled_at_text}</b>${a.plate ? ` cho xe <b>${a.plate}</b>` : ''}${a.vehicle ? ` (${a.vehicle})` : ''}.</p>`\n  + (a.request_note ? `<p>Nội dung yêu cầu: <i>${a.request_note}</i></p>` : '')\n  + `<p>Nếu cần đổi hoặc huỷ lịch, Quý khách vui lòng liên hệ ${a.branch_name}${a.branch_phone ? ` — <b>${a.branch_phone}</b>` : ''}.</p>`\n  + `<p style=\"color:#888;font-size:12px\">Trạng thái hiện tại: ${a.status === 'confirmed' ? 'đã xác nhận' : 'chờ xác nhận'}</p>`;\n\nreturn { json: {\n  email_to: a.customer_email,\n  email_subject: `📅 Nhắc lịch hẹn ${a.scheduled_at_text} — ${a.branch_name}`,\n  email_html: html\n} };"
      },
      "id": "ar-format",
      "name": "Soạn thư nhắc",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        120
      ]
    },
    {
      "parameters": {
        "fromEmail": "care@anser.auto",
        "toEmail": "={{ $json.email_to }}",
        "subject": "={{ $json.email_subject }}",
        "html": "={{ $json.email_html }}",
        "options": {}
      },
      "id": "ar-email-customer",
      "name": "Gửi khách hàng",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1280,
        120
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.count }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "ar-if-count",
      "name": "Có lịch hẹn?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        620,
        440
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Bảng phân công cho lễ tân sáng hôm sau — kèm cột cho biết khách nào cần gọi tay.\nconst d = $json;\nconst items = d.items || [];\n\nconst rows = items.map(a => `<tr><td>${a.scheduled_at_text}</td><td>${a.customer_name || '—'}</td><td>${a.customer_phone || '—'}</td><td>${a.plate || '—'}</td><td>${a.branch_name}</td><td>${a.request_note || '—'}</td><td>${a.contactable ? 'Đã gửi email' : '⚠️ Gọi điện'}</td></tr>`).join('');\n\nconst html = `<h2>📅 ${items.length} lịch hẹn trong 24 giờ tới</h2>`\n  + `<p>Đã nhắc tự động <b>${d.contactable_count}</b>/${items.length} khách qua email. Số còn lại cần gọi điện xác nhận.</p>`\n  + `<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse:collapse\">`\n  + `<tr><th>Giờ hẹn</th><th>Khách hàng</th><th>SĐT</th><th>Biển số</th><th>Chi nhánh</th><th>Yêu cầu</th><th>Liên hệ</th></tr>${rows}</table>`\n  + `<p style=\"color:#888;font-size:12px\">ANSER Auto — ${new Date().toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' })}</p>`;\n\nreturn { json: { email_to: d.company_email, email_subject: `📅 ${items.length} lịch hẹn ngày mai`, email_html: html } };"
      },
      "id": "ar-format-summary",
      "name": "Soạn bảng phân công",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        440
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.email_to }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "ar-if-company-email",
      "name": "Gara có email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1060,
        440
      ]
    },
    {
      "parameters": {
        "fromEmail": "alerts@anser.auto",
        "toEmail": "={{ $json.email_to }}",
        "subject": "={{ $json.email_subject }}",
        "html": "={{ $json.email_html }}",
        "options": {}
      },
      "id": "ar-email-garage",
      "name": "Gửi gara",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1280,
        440
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3000/api/n8n/internal/heartbeat",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "REPLACE_WITH_N8N_INTERNAL_TOKEN"
            },
            {
              "name": "X-Anser-Trigger",
              "value": "={{ $execution.mode === 'production' ? 'schedule' : 'manual' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"type\": \"appointment_reminder\", \"status\": \"ok\"}",
        "options": {}
      },
      "id": "hb-appointment_reminder",
      "name": "Báo app: đã gửi",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1520,
        440
      ],
      "executeOnce": true
    }
  ],
  "connections": {
    "Mỗi ngày 17h": {
      "main": [
        [
          {
            "node": "Lấy lịch hẹn 24h tới",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lấy lịch hẹn 24h tới": {
      "main": [
        [
          {
            "node": "Tách từng lịch hẹn",
            "type": "main",
            "index": 0
          },
          {
            "node": "Có lịch hẹn?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tách từng lịch hẹn": {
      "main": [
