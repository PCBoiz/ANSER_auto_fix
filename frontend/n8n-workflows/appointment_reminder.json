    "Soạn thư nhắc": {
      "main": [
        [
          {
            "node": "Gửi khách hàng",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Có lịch hẹn?": {
      "main": [
        [
          {
            "node": "Soạn bảng phân công",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Soạn bảng phân công": {
      "main": [
        [
          {
            "node": "Gara có email?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gara có email?": {
      "main": [
        [
          {
            "node": "Gửi gara",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Gửi gara": {
      "main": [
        [
          {
            "node": "Báo app: đã gửi",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
