{
  "name": "ANSER Auto — Cảnh báo phụ tùng sắp hết",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "ls-trigger",
      "name": "Mỗi 6 giờ",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        180,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:3000/api/n8n/internal/branches",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "REPLACE_WITH_N8N_INTERNAL_TOKEN"
            },
            {
              "name": "X-Anser-Trigger",
              "value": "={{ $execution.mode === 'production' ? 'schedule' : 'manual' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "ls-branches",
      "name": "Lấy danh sách chi nhánh",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "branches",
        "options": {}
      },
      "id": "ls-split",
      "name": "Tách từng chi nhánh",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        620,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'http://host.docker.internal:3000/api/n8n/internal/low-stock?branchId=' + $json.id + '&limit=30' }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "REPLACE_WITH_N8N_INTERNAL_TOKEN"
            },
            {
              "name": "X-Anser-Trigger",
              "value": "={{ $execution.mode === 'production' ? 'schedule' : 'manual' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "ls-fetch",
      "name": "Kiểm tra tồn kho",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        840,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.count }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "ls-if-count",
      "name": "Có phụ tùng dưới ngưỡng?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1060,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Chạy một lần cho MỖI chi nhánh: $json là kết quả low-stock của chính chi nhánh đó,\n// $('Tách từng chi nhánh').item là chi nhánh tương ứng (n8n tự ghép cặp theo item).\nconst data = $json;\nconst branch = $('Tách từng chi nhánh').item.json;\nconst items = data.items || [];\n// `total` là số mã THẬT dưới ngưỡng; `items` chỉ gồm tối đa 30 mã tồn thấp nhất.\nconst total = data.total ?? items.length;\n\nconst rows = items.map(p => `<tr><td>${p.code}</td><td>${p.name}</td><td>${p.oem_number || '—'}</td><td align=\"right\"><b>${p.stock}</b> ${p.unit}</td><td align=\"right\">${p.threshold}</td><td>${p.location || '—'}</td></tr>`).join('');\n\nconst html = `<h2>🔧 Phụ tùng sắp hết — ${branch.name}</h2>`\n  + `<p>Có <b>${total}</b> mã phụ tùng đã chạm hoặc dưới ngưỡng cảnh báo. Cần đặt hàng trước khi xe vào xưởng mà không có đồ thay.</p>`\n  + `<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse:collapse\">`\n  + (data.truncated ? `<p><i>Chỉ liệt kê ${items.length} mã tồn thấp nhất.</i></p>` : '')\n  + `<tr><th>Mã</th><th>Tên phụ tùng</th><th>Mã OEM</th><th>Còn lại</th><th>Ngưỡng</th><th>Vị trí</th></tr>${rows}</table>`\n  + `<p style=\"color:#888;font-size:12px\">ANSER Auto — ${new Date().toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' })}</p>`;\n\nreturn { json: {\n  email_to: branch.notification_email,\n  email_subject: `🔧 ${total} phụ tùng sắp hết — ${branch.name}`,\n  email_html: html\n} };"
      },
      "id": "ls-format",
      "name": "Soạn cảnh báo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.email_to }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "ls-if-email",
      "name": "Có email nhận?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1500,
        200
      ]
    },
    {
      "parameters": {
        "fromEmail": "alerts@anser.auto",
        "toEmail": "={{ $json.email_to }}",
        "subject": "={{ $json.email_subject }}",
        "html": "={{ $json.email_html }}",
        "options": {}
      },
      "id": "ls-email",
      "name": "Gửi Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1720,
        140
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3000/api/n8n/internal/heartbeat",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "REPLACE_WITH_N8N_INTERNAL_TOKEN"
            },
            {
              "name": "X-Anser-Trigger",
              "value": "={{ $execution.mode === 'production' ? 'schedule' : 'manual' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"type\": \"low_stock_alert\", \"status\": \"ok\"}",
        "options": {}
      },
      "id": "hb-low_stock_alert",
      "name": "Báo app: đã gửi",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1960,
        140
      ],
      "executeOnce": true
    }
  ],
  "connections": {
    "Mỗi 6 giờ": {
      "main": [
        [
          {
            "node": "Lấy danh sách chi nhánh",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lấy danh sách chi nhánh": {
      "main": [
        [
          {
            "node": "Tách từng chi nhánh",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tách từng chi nhánh": {
      "main": [
        [
          {
            "node": "Kiểm tra tồn kho",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Kiểm tra tồn kho": {
      "main": [
        [
          {
            "node": "Có phụ tùng dưới ngưỡng?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Có phụ tùng dưới ngưỡng?": {
      "main": [
        [
          {
            "node": "Soạn cảnh báo",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Soạn cảnh báo": {
      "main": [
        [
          {
            "node": "Có email nhận?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Có email nhận?": {
      "main": [
        [
          {
            "node": "Gửi Email",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Gửi Email": {
      "main": [
        [
          {
            "node": "Báo app: đã gửi",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
